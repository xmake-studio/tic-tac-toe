{
  "info": {
    "name": "tic-tac-toe",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8008"},
    {"key": "game_id", "value": ""}
  ],
  "item": [
    {
      "name": "Создать игру",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('game_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/games"
      }
    },
    {
      "name": "Получить игру",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/games/{{game_id}}"
      }
    },
    {
      "name": "Сделать ход",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"row\": 1, \"col\": 1}"},
        "url": "{{base_url}}/games/{{game_id}}/moves"
      }
    }
  ]
}
